# ==============================================================================
# Synthex Studio — Production Environment Configuration
# Copy this file to .env.local for local testing or configure in Cloud Run / Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
# The public domain of your deployed application (required for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=https://your-domain.run.app

# ------------------------------------------------------------------------------
# 2. AI Providers (Server-Side Only - Never exposed to client)
# ------------------------------------------------------------------------------
# Required for primary graph reasoning, Hipporag retrieval, and web research
GEMINI_API_KEY=your_gemini_api_key_here
# Optional secondary/fallback LLM provider
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. Clerk Authentication & Team Multi-Tenancy
# ------------------------------------------------------------------------------
# Public key for browser client (ClerkProvider, UserNav, Sign-In/Up)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Secret key for server-side route protection and token verification
CLERK_SECRET_KEY=sk_test_...
# Webhook secret to verify user.created and org membership events
CLERK_WEBHOOK_SECRET=whsec_...
# Custom sign-in / sign-up route paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# ------------------------------------------------------------------------------
# 4. Stripe Monetization, Subscriptions & Refills
# ------------------------------------------------------------------------------
# Secret key from Stripe Dashboard (Developers -> API keys)
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret from Stripe Dashboard (Developers -> Webhooks)
# Webhook endpoint URL: https://your-domain.run.app/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Public publishable key for client if needed
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ------------------------------------------------------------------------------
# 5. Google Cloud Platform (GCS) Document Vault
# ------------------------------------------------------------------------------
# Name of the GCS bucket for PDF and image attachments
# When configured, replaces local disk fallback with enterprise durable storage
GCS_BUCKET_NAME=synthex-document-vault-prod

# ------------------------------------------------------------------------------
# 6. Database (Dual-Mode: Local SQLite or Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Leave empty for zero-config offline SQLite (canvas.db).
# In production on Vercel / serverless, connect Neon PostgreSQL via Vercel Storage
# or set DATABASE_URL / POSTGRES_URL. Schema & default workspace are auto-provisioned!
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=
